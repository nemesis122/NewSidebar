<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SidebarByNemeSIS</AssemblyName>
    <Version>3.1.2.0</Version>
    <AssemblyVersion>3.1.2.0</AssemblyVersion>
    <FileVersion>3.1.2.0</FileVersion>
    <InformationalVersion>3.01.2.0</InformationalVersion>
    <Product>Sidebar by NemeSIS</Product>
    <Title>Sidebar by NemeSIS</Title>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>aurora.ico</ApplicationIcon>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../OpenHardwareMonitor.Driverless/OpenHardwareMonitor.Driverless.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" /><PackageReference Include="WPF-UI" Version="4.3.0" /></ItemGroup>
  <ItemGroup>
    <Content Include="../Licenses/**/*" Link="Licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../OpenHardwareMonitor.Driverless/LICENSE.txt" Link="Licenses/OpenHardwareMonitor-MPL-2.0.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../OpenHardwareMonitor.Driverless/README.md" Link="Licenses/OpenHardwareMonitor-MODIFICATIONS.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>





